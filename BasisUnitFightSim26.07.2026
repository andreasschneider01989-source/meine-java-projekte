package ordner1;

import javax.swing.*;
import java.awt.*;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.BasicStroke; // Wird für die dicke Rand-Markierung benötigt

//Basis Unit Fight Sim To Chess Vision 16v16 Konsolnausgabe in Eclipse für LLMs Kopierbar und analysierbar für KI-Games Matrixgame AlphaZero Didaktik und Entscheidungsalgorithmen für Zielerreichungen geplant und sehr sinnvoll 16.07.2026,14:15UhrAndreasSchneider zuHause
public class SchönerZoom2FormScaleUnitsBasisFightToChessVision extends JPanel {

	// --- Instanzvariablen (NICHT static) ---
	private int FRAME_WIDTH = 1920;
	private int FRAME_HEIGHT = 1080;
	private double zoomFactor = 0.0001;
	private double zoomCenterX = 0;
	private double zoomCenterY = 0;
	private static final double ZOOM_STEP = 1.2;
	private double feinheit = 70;
	private int pause = 30;
	private double PAN_STEP = 0.0001;

	// Wichtig: unitList als Instanzvariable
	private List<Unit> unitList = new ArrayList<>();

	// --- NEU: Temporäre Liste für neu erschaffene Einheiten und Gebäude ---
	private List<Unit> unitsToAdd = new ArrayList<>();

	// --- Konstruktor ---
	public SchönerZoom2FormScaleUnitsBasisFightToChessVision() {
		initializeSettings();
		initializeUnits();
		setupPanel();
	}

	private void initializeSettings() {
		PAN_STEP = feinheit / zoomFactor;
	}

	// Variablen für das zeitgesteuerte Logging (oben in der Klasse deklarieren)
	private long lastConsolePrintTime = 0;

